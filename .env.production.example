# Copy this file to .env.production and fill in real values before deploying.
#   cp .env.production.example .env.production

# --- Secrets: generate fresh values, do not reuse dev/test secrets ---
# e.g. openssl rand -hex 32
REDASH_COOKIE_SECRET=
REDASH_SECRET_KEY=

# --- Point at your EXISTING production Postgres/Redis (not the dev containers) ---
REDASH_DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/<database>
REDASH_REDIS_URL=redis://<redis-host>:6379/0

# --- Public hostname this deployment will be reachable at ---
REDASH_HOST=https://<your-domain>

# --- Recommended production settings ---
REDASH_LOG_LEVEL=INFO
REDASH_RATELIMIT_ENABLED=true
REDASH_ENFORCE_CSRF=true
REDASH_WEB_WORKERS=4

# --- Mail (adjust or disable per your environment) ---
REDASH_MAIL_DEFAULT_SENDER=redash@your-domain.com
REDASH_MAIL_SERVER=

# --- Port this stack is exposed on (kept separate from the existing v9 stack) ---
EXPOSED_HTTP_PORT=8090

# --- drill-api build-time targets (hostnames/IPs it will connect to) ---
# If you already have a production drill-api instance serving the old portal,
# consider pointing DRILL_API_BACKEND_IP at the SAME Redash you're deploying here
# and reusing that instance instead of building a second one — see the caveat
# about the drill-api's "works with Redash 8/9" assumption before doing so.
DRILL_API_BACKEND_IP=server
DRILL_API_CLICKHOUSE_IP=<your-clickhouse-host>
DRILL_API_INCIDENT_IP=<your-incident-mysql-host-if-any>
