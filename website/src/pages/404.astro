---
import MarketingLayout from '../layouts/MarketingLayout.astro'
import Layout from '../react/components/Layout.jsx'
---

<MarketingLayout title="Page not found">
  <Layout>
    <section class="section section--pt-lg">
      <div class="container text-center">
        <h1>Page not found</h1>
        <p class="highlight-p">The page you're looking for doesn't exist or has moved.</p>
        <p>
          <a href="/" class="btn btn-primary">Home</a>
          <a href="/help/" class="btn btn-secondary">Knowledge Base</a>
        </p>
      </div>
    </section>
  </Layout>
</MarketingLayout>
