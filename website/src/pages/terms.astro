---
import { getEntry } from 'astro:content'
import MarketingLayout from '../layouts/MarketingLayout.astro'
import Page from '../react/pages/TextPage.jsx'

const entry = await getEntry('textPages', 'terms')
---

<MarketingLayout title={entry.data.title}>
  <Page data={{ markdownRemark: { frontmatter: entry.data, html: entry.rendered?.html } }} />
</MarketingLayout>
