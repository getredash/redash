{
  "presets": [
    "@babel/preset-env",
    ["@babel/preset-react", { "runtime": "classic" }],
    ["@babel/preset-typescript", { "onlyRemoveTypeImports": false }]
  ],
  "plugins": [
    "@babel/plugin-transform-class-properties",
    ["polyfill-corejs3", { "method": "usage-global", "version": "3.50" }]
  ],
  "env": {
    "test": {
      "plugins": ["istanbul"]
    }
  }
}
